# Public source allowlist. Local acceptance data and credentials stay untracked.
/*
!/.gitignore
!/README.md
!/LICENSE
!/ACKNOWLEDGEMENTS.md
!/pyproject.toml
!/plugin.yaml
!/__init__.py
!/src/
!/tests/
!/preview/
!/scripts/
!/docs/
!/.github/

/docs/*
!/docs/architecture.md
!/docs/installation.md
!/docs/acceptance.md
!/docs/session-experience.md
!/docs/feishu-api-contract.md
!/docs/release-readme.md
!/docs/THIRD_PARTY_NOTICES.md
!/docs/source-lock.json
!/docs/host-contract.json
!/docs/feature-host-contract.json

/scripts/*
!/scripts/build_release.py
!/scripts/build_preview.py
!/scripts/verify.py
!/scripts/verify_container.py
!/scripts/verify_host.py
!/scripts/host_smoke.py
!/scripts/verify_preview.cjs
!/scripts/fetch_references.py
!/scripts/generate_activity_asset.py
!/scripts/check_public_tree.py

.reference-cache/
artifacts/
dist/
.env
.env.*
.venv/
__pycache__/
*.pyc
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.owner
*.log
*.pid
*.pem
*.key
*.egg-info/
node_modules/
.DS_Store
